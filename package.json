{
  "name": "portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.3.4",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "video:studio": "remotion studio video/index.ts --no-open",
    "video:render:kodl": "remotion render video/index.ts KodlPreview public/videos/kodl-preview.mp4 --codec=h264 --crf=28 --pixel-format=yuv420p",
    "video:render:finder": "remotion render video/index.ts FinderPreview public/videos/finder-preview.mp4 --codec=h264 --crf=28 --pixel-format=yuv420p",
    "video:render:seigos": "remotion render video/index.ts SeigosPreview public/videos/seigos-preview.mp4 --codec=h264 --crf=28 --pixel-format=yuv420p",
    "video:render:orvexorm": "remotion render video/index.ts OrvexOrmPreview public/videos/orvexorm-preview.mp4 --codec=h264 --crf=28 --pixel-format=yuv420p",
    "video:render": "bun run video:render:kodl && bun run video:render:finder && bun run video:render:seigos && bun run video:render:orvexorm"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.8.1",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.537",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@typescript/native": "^7.0.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.31",
    "remotion": "^4.0.537",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.2"
  }
}
